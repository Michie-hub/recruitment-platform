# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=recruitment_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- S3 / MinIO (local dev uses MinIO, an S3-compatible local object store) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=resumes
S3_REGION=us-east-1

# --- ChromaDB (vector store for semantic candidate/job matching) ---
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- JWT (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=replace_with_generated_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

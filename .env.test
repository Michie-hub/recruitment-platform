# Local-only overrides for running pytest OUTSIDE Docker (i.e. from your
# Windows host, not from inside a container).
#
# Why these differ from .env:
# - .env is written for container-to-container communication (e.g.
#   POSTGRES_HOST=db, CHROMA_HOST=chroma), which only resolves inside
#   Docker's internal network.
# - Tests run directly on the host (pytest, not docker compose exec),
#   so they need host-reachable addresses instead: localhost + whatever
#   port Docker actually published.
#
# POSTGRES_PORT=5435 specifically (not 5432) because two native Windows
# PostgreSQL services were already bound to 5432 and 5433 on this
# machine — Docker's Postgres was remapped to 5435 in docker-compose.yml
# to avoid the collision. If you hit "password authentication failed"
# on a fresh machine, check `netstat -ano | grep 543` for a similar
# port collision before assuming credentials are wrong.
#
# Usage: source .env.test   (Git Bash / WSL)

export POSTGRES_HOST=localhost
export POSTGRES_PORT=5435
export CHROMA_HOST=localhost
export CHROMA_PORT=8001
export REDIS_HOST=localhost
# REDIS_PORT not overridden — docker-compose.yml maps 6379:6379 with no
# known collision (unlike Postgres). If you ever see a Redis connection
# error, check `netstat -ano | grep 6379` for a native Redis install
# the same way we found the two native Postgres services.
